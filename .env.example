# Execution provider settings
AIRP_EXECUTION_PROVIDER=openrouter

# OpenRouter execution settings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_MODELS=openai/gpt-4.1-mini,anthropic/claude-3.5-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_APP_NAME=AI Reputation Intelligence Platform
OPENROUTER_APP_URL=http://localhost:8501

# Azure OpenAI prompt generation + optional execution settings
AZURE_OPENAI_API_KEY=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/openai/v1/chat/completions
AZURE_FOUNDRY_MODELS=gpt-5.3-codex-Emmanuel-Ajayi
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
AZURE_FOUNDRY_TIMEOUT_SECONDS=45
